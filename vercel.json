{
  "buildCommand": "prisma generate && next build && node scripts/postbuild-copy-engine.cjs",
  "devCommand": "next dev --webpack",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "PRISMA_QUERY_ENGINE_BINARY": "/var/task/generated/prisma/libquery_engine-rhel-openssl-3.0.x.so.node"
  },
  "functions": {
    "app/api/scans/**/*": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/api/auth/**/*": {
      "maxDuration": 10,
      "memory": 256
    },
    "app/api/admin/**/*": {
      "maxDuration": 10,
      "memory": 256
    }
  }
}
