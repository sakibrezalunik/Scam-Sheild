# ScamShield — Environment Variables (copy to .env.local for development)
# For Vercel deployment, set these as Environment Variables in the Vercel dashboard.

# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required for all API routes)
# Vercel: use a Neon/Supabase/managed PostgreSQL instance
DATABASE_URL="postgresql://user:password@host:5432/scamshield?schema=public"

# Node environment (set by Vercel automatically; do not override)
NODE_ENV="development"

# ─── AI Analysis (at least one provider required) ─────────────────────────────

# Gemini (primary) — sign up at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# OpenAI (fallback when GEMINI_API_KEY is empty)
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""          # Optional: custom endpoint (e.g. for compatible providers)

# Shared: request timeout in milliseconds
AI_TIMEOUT_MS="10000"

# ─── Optional ─────────────────────────────────────────────────────────────────

# Future: Stripe (for payments)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
