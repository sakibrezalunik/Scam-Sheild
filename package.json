{
  "name": "scamshield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build && node scripts/postbuild-copy-engine.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "cleanup": "tsx scripts/cleanup-scans.ts --delete",
    "admin:promote": "npx tsx scripts/admin-promote.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/adapter-pg": "^6",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "^3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.484",
    "next": "16.3.5",
    "openai": "^4",
    "prisma": "^6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
