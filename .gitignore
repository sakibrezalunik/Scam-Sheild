# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage
/test-results

# next.js
/.next/
/out/

# production
/build
**/dist/
**/target/

# misc
.DS_Store
*.pem
*.png
!public/**/*.png
!extension/assets/*.png
!desktop/src-tauri/icons/*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.exe
*.msi
*.dll
*.node

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example as the documented template
.env*
!.env.example

# vercel
.vercel

# docs (local-only, not for GitHub)
/docs/

# generated Prisma client
generated/prisma/

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / one-off files
MEMORY.md
*.ps1
*.fixed
Image/
