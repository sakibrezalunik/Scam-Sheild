{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "chrome"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@popup/*": ["src/popup/*"],
      "@types": ["src/types/index.ts"],
      "@api/*": ["src/api/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
